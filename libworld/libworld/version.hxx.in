#pragma once

// The numeric version format is AAAAABBBBBCCCCCDDDE where:
//
// AAAAA - major version number
// BBBBB - minor version number
// CCCCC - bugfix version number
// DDD   - alpha / beta (DDD + 500) version number
// E     - final (0) / snapshot (1)
//
// When DDDE is not 0, 1 is subtracted from AAAAABBBBBCCCCC. For example:
//
// Version      AAAAABBBBBCCCCCDDDE
//
// 0.1.0        0000000001000000000
// 0.1.2        0000000001000020000
// 1.2.3        0000100002000030000
// 2.2.0-a.1    0000200001999990010
// 3.0.0-b.2    0000299999999995020
// 2.2.0-a.1.z  0000200001999990011
//
#define LIBWORLD_VERSION       $libworld.version.project_number$ULL
#define LIBWORLD_VERSION_STR   "$libworld.version.project$"
#define LIBWORLD_VERSION_ID    "$libworld.version.project_id$"
#define LIBWORLD_VERSION_FULL  "$libworld.version$"

#define LIBWORLD_VERSION_MAJOR $libworld.version.major$
#define LIBWORLD_VERSION_MINOR $libworld.version.minor$
#define LIBWORLD_VERSION_PATCH $libworld.version.patch$

#define LIBWORLD_PRE_RELEASE   $libworld.version.pre_release$

#define LIBWORLD_SNAPSHOT_SN   $libworld.version.snapshot_sn$ULL
#define LIBWORLD_SNAPSHOT_ID   "$libworld.version.snapshot_id$"
