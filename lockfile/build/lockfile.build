# Apply pinned dependency versions to the bpkg configurations.
# Sourced from build/bootstrap.build.
#
# The lockfile (bdep.lock) lives in $src_root (the lockfile package source
# dir). On every build, it reads the pinned name/version entries and enforces
# them in the bpkg configurations that contain those packages.
#
# Packages are discovered per-configuration via bdep status. For each non-host
# configuration that contains packages with version mismatches, bpkg pkg-build
# is run to apply the required version. The source configuration for pkg-build
# defaults to the configuration that holds the package. If that configuration
# has no remote (pkg:/git:) repositories registered, the bpkg configuration
# that builds the lockfile package (bpkg_cfg, derived from $out_root) is used
# as fallback. --no-move keeps every package in its current configuration
# regardless of which source is used.
# When a fallback source is needed, its remote repositories are temporarily
# added to the package's own config so pkg-build can resolve the pinned
# version, then removed immediately after. This avoids db-identity issues and
# lets bpkg find the package in the correct configuration.
# --leave-dependent is passed to bpkg pkg-build so that bpkg does not try to
# reconfigure dependent packages across linked configurations during the pin
# step. The final bdep sync call handles all reconfiguration correctly in the
# project's multi-config topology.
# After any version change, bdep sync re-configures the project packages that
# were affected.
#
# The only configuration type handled explicitly is 'host', which is skipped
# because host configurations contain build-time tools managed separately by
# bdep.
#
# To disable enforcement for one build:
#
#   BDEP_SYNC=false b
#
if ($build.mode         != 'skeleton'    && \
    !$null($build.meta_operation)        && \
    $build.meta_operation != 'info'      && \
    $build.meta_operation != 'configure' && \
    $build.meta_operation != 'disfigure')
{
  if ($getenv('BDEP_SYNC') == [null] || \
      $getenv('BDEP_SYNC') == true   || \
      $getenv('BDEP_SYNC') == 1)
  {
    lockfile = [string] $src_root/bdep.lock
    if ($filesystem.file_exists($lockfile))
    {
      # Read pinned name/version entries, skipping comments and blank lines.
      # The \r? handles CRLF line endings: build2 splits process output on \n
      # only, leaving \r in the line content, and [:space:] excludes \r from
      # the token so without \r? full-line matching fails on CRLF files.
      allpins = $process.run_regex(\
        cat "$src_root/bdep.lock", \
        '^([^#[:space:]][^[:space:]]*)\r?', \
        '\1')

      if (!$null($allpins))
      {
        # Resolve the amalgamation root dynamically rather than assuming $src_root/..
        # so the lockfile package works correctly at any nesting depth.
        amg_rel  = $process.run_regex(\
          b "info:" "$src_root/", \
          '^amalgamation: (.+)', \
          '\1')
        amg_root = $path.normalize($src_root/$amg_rel)

        # Derive the bpkg configuration root from $out_root using the same
        # amalgamation-relative path. This is the config where the lockfile
        # package itself is built and is the natural fallback source for pkg-build
        # when the target config has no remote repos.
        if ($null($amg_rel))
          bpkg_cfg = $out_root
        else
          bpkg_cfg = $path.normalize($out_root/$amg_rel)

        # Filter out project-local packages from the pin list.
        # bdep status errors if the same call includes both an initialized
        # project package (pkg-spec) and an external dep (dep-spec): e.g.
        # "bdep status dep1 libhello" fails with "initialized package
        # libhello specified with dependency package dep1".
        # Also exclude project packages from the inner pin-matching loop:
        # linked configs (e.g. an external config) may have project packages
        # shadow-installed by bdep, so using allpins would incorrectly try
        # to pin those project packages when their version differs.
        prj_names = $process.run_regex(\
          bdep status -d "$amg_root", \
          '^!?([^ ]+) .*', \
          '\1')
        dep_names = [null]
        dep_pins  = [null]
        for pin: $allpins
        {
          pname = $regex.replace($pin, '^([^/]+)/.*', '\1')
          in_prj = false
          for pn: $prj_names
          {
            if ($pn == $pname)
            {
              in_prj = true
              break
            }
          }
          if (!$in_prj)
          {
            dep_names += $pname
            dep_pins  += $pin
          }
        }

        if (!$null($dep_pins) && !$empty($dep_pins))
        {
          # Discover which configuration each pinned package lives in.
          # bdep status reports packages from linked configurations with the
          # configuration path in square brackets after the package name.
          # Sort results so identical paths are adjacent for dedup below.
          linked_cfgs = $sort($process.run_regex(\
            bdep status -d "$amg_root" $dep_names, \
            '^[^ ]+ \[([^\]]*)\] configured.*', \
            '\1'))

          # For each non-host config that has mismatched packages, collect the
          # pending pins and apply them via the best available source config.
          ran_pkg_build = false
          prev_cfg = [null]
          for lcfg: $linked_cfgs
          {
            if ($lcfg != $prev_cfg)
            {
              prev_cfg = $lcfg

              # Skip host-type configurations: they contain build-time tools
              # managed separately by bdep.
              cfg_type = $process.run_regex(\
                bpkg cfg-info -d "$lcfg", \
                '^type: (.+)', \
                '\1')

              if ($cfg_type != 'host')
              {
                # Snapshot all packages currently in this configuration as
                # captured lines. process.run_regex uses full-line matching so
                # the pattern must consume the entire output line; the trailing
                # .+ ensures this. Name and version are then extracted via
                # regex.replace (partial matching) in the comparison loop.
                before_pkgs = $process.run_regex(\
                  bpkg pkg-status --all -d "$lcfg", \
                  '^!?(.+ configured .+)', \
                  '\1')

                pending_pins = [null]
                for pin: $dep_pins
                {
                  pname = $regex.replace($pin, '^([^/]+)/.*', '\1')
                  pver  = $regex.replace($pin, '^[^/]+/(.*)', '\1')

                  for bpkg_entry: $before_pkgs
                  {
                    bname = $regex.replace($bpkg_entry, '^([^ ]+) .*', '\1')
                    bver  = $regex.replace($bpkg_entry, '^.+ configured !?([^ ]+).*', '\1')

                    if ($bname == $pname)
                    {
                      # A pin without +N suffix matches any revision of that base
                      # version (bpkg semantics: pkg-build X.Y.Z satisfies X.Y.Z+N).
                      # Only compare full strings when the pin carries an explicit +N.
                      pbase = $regex.replace($pver, '\+[0-9]+$', '')
                      bbase = $regex.replace($bver, '\+[0-9]+$', '')
                      if ($bbase != $pbase || \
                          ($pver != $pbase && $bver != $pver))
                      {
                        text "lockfile:" pinning $pname to $pver in $lcfg \(was $bver\)
                        pending_pins += $pin
                      }
                      break
                    }
                  }
                }

                if (!$null($pending_pins))
                {
                  # Pre-step: sync remote repositories across bpkg_cfg and the configs it
                  # directly links to. bpkg cfg-info --link lists bpkg_cfg itself first,
                  # then each linked config. Only non-host configs are considered.
                  # This patches setups where the init/deinit dance left linked configs
                  # without direct remote repos.
                  sync_cfgs  = $process.run_regex(\
                    bpkg cfg-info --link -d "$bpkg_cfg", '^path: (.+)', '\1')
                  sync_repos = [null]
                  for sync_cfg: $sync_cfgs
                  {
                    sync_ctype = $process.run_regex(\
                      bpkg cfg-info -d "$sync_cfg", '^type: (.+)', '\1')
                    if ($sync_ctype != 'host')
                    {
                      for r: $process.run_regex(\
                        bpkg rep-list -d "$sync_cfg", '^pkg:.+ (.+)', '\1')
                        sync_repos += $r
                      for r: $process.run_regex(\
                        bpkg rep-list -d "$sync_cfg", '^git:.+ (.+)', '\1')
                        sync_repos += $r
                    }
                  }

                  if (!$null($sync_repos))
                  {
                    for sync_cfg: $sync_cfgs
                    {
                      sync_ctype = $process.run_regex(\
                        bpkg cfg-info -d "$sync_cfg", '^type: (.+)', '\1')
                      if ($sync_ctype != 'host')
                      {
                        sync_have = [null]
                        for r: $process.run_regex(\
                          bpkg rep-list -d "$sync_cfg", '^pkg:.+ (.+)', '\1')
                          sync_have += $r
                        for r: $process.run_regex(\
                          bpkg rep-list -d "$sync_cfg", '^git:.+ (.+)', '\1')
                          sync_have += $r
                        sync_add = [null]
                        for r: $sync_repos
                        {
                          sync_found = false
                          for h: $sync_have
                          {
                            if ($h == $r)
                            {
                              sync_found = true
                              break
                            }
                          }
                          if (!$sync_found)
                            sync_add += $r
                        }
                        if (!$null($sync_add))
                        {
                          text "lockfile:" complement with $sync_add [$sync_cfg]
                          ignored = $process.run(bpkg rep-add $sync_add -d "$sync_cfg")
                          ignored = $process.run(bpkg rep-fetch --offline --trust-yes -d "$sync_cfg")
                        }
                      }
                    }
                  }

                  # Find a source configuration to run pkg-build from.
                  # Prefer lcfg itself; fall back to bpkg_cfg (the config that
                  # builds the lockfile package). The trailing .* ensures the
                  # pattern consumes the entire line as required by
                  # process.run_regex's full-line matching.
                  source_cfg = [null]
                  use_fallback = false
                  has_remote = $process.run_regex(\
                    bpkg rep-list -d "$lcfg", \
                    '^(pkg|git):.*', \
                    '\1')
                  if (!$empty($has_remote))
                    source_cfg = $lcfg
                  else
                  {
                    has_remote = $process.run_regex(\
                      bpkg rep-list -d "$bpkg_cfg", \
                      '^(pkg|git):.*', \
                      '\1')
                    if (!$empty($has_remote))
                    {
                      source_cfg = $bpkg_cfg
                      use_fallback = true
                    }
                  }
                  if ($null($source_cfg))
                    fail "lockfile:" cannot pin $pending_pins -- \
                      no project configuration has remote package repositories

                  # When using a fallback source config (different from lcfg),
                  # temporarily borrow source_cfg's remote repositories into
                  # lcfg so that bpkg pkg-build can resolve the pinned version,
                  # then remove them immediately after. Running pkg-build from
                  # lcfg itself keeps bpkg's hold-package db identity correct.
                  if ($use_fallback)
                  {
                    # Extract remote repo URLs from source_cfg.
                    # bpkg rep-list output: "<location> <url>".
                    # Greedy .+ backtracks to the last space, so (.+) captures
                    # the URL. process.run_regex may yield an empty-string
                    # element for non-matching lines; the for-loops skip those.
                    source_repos = [null]
                    for r: $process.run_regex(\
                      bpkg rep-list -d "$source_cfg", \
                      '^pkg:.+ (.+)', '\1')
                      source_repos += $r
                    for r: $process.run_regex(\
                      bpkg rep-list -d "$source_cfg", \
                      '^git:.+ (.+)', '\1')
                      source_repos += $r
                    ignored = $process.run(bpkg rep-add $source_repos -d "$lcfg")
                    ignored = $process.run(bpkg rep-fetch --trust-yes -d "$lcfg")
                    ignored = $process.run(\
                      bpkg pkg-build --yes --no-move --configure-only --leave-dependent $pending_pins -d "$lcfg")
                    for srepo: $source_repos
                      ignored = $process.run(bpkg rep-remove "$srepo" -d "$lcfg")
                  }
                  else
                  {
                    ignored = $process.run(\
                      bpkg pkg-build --yes --no-move --configure-only --leave-dependent $pending_pins -d "$lcfg")
                  }
                  ran_pkg_build = true
                }
              }
            }
          }

          if ($ran_pkg_build)
            ignored = $process.run(bdep sync --yes -d "$amg_root")
        }
      }
    }
  }
}
